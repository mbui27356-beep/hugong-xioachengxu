<nav-bar title="{{id ? '编辑就诊人' : '添加就诊人'}}" scrolled="{{scrolled}}" />

<view class="page page-bar">
  <view class="page-head">
    <view class="title-2">{{id ? '编辑就诊人' : '添加就诊人'}}</view>
    <view class="lead">只填写安排服务所需的信息，不需要身份证。</view>
  </view>

  <view class="group-label">就诊人</view>
  <view class="group">
    <view class="field">
      <view class="field-label">姓名</view>
      <input class="field-input" placeholder="必填" placeholder-class="placeholder" value="{{form.name}}" maxlength="20" data-key="name" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">性别</view>
      <view class="segmented" style="flex:1;">
        <view wx:for="{{genders}}" wx:key="value" class="seg {{form.gender === item.value ? 'seg-on' : ''}}" data-value="{{item.value}}" bindtap="pickGender">{{item.label}}</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">年龄</view>
      <input class="field-input" type="number" placeholder="选填" placeholder-class="placeholder" value="{{ageText}}" maxlength="3" bindinput="onAge" />
      <text class="secondary subhead">岁</text>
    </view>
  </view>

  <view class="group-label">紧急联系人</view>
  <view class="group">
    <view class="field">
      <view class="field-label">姓名</view>
      <input class="field-input" placeholder="必填" placeholder-class="placeholder" value="{{form.contactName}}" maxlength="20" data-key="contactName" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">手机号</view>
      <input class="field-input num" type="number" placeholder="11 位手机号" placeholder-class="placeholder" value="{{form.contactPhone}}" maxlength="11" data-key="contactPhone" bindinput="onInput" />
    </view>
  </view>
  <view class="group-footer">手机号格式正确不代表已完成号码验证，护工到岗前会电话确认。</view>

  <view class="group-label">联系人是就诊人的</view>
  <view class="rel-wrap">
    <view wx:for="{{relations}}" wx:key="*this" class="chip {{form.contactRelation === item ? 'chip-on' : ''}}" data-value="{{item}}" bindtap="pickRelation">{{item}}</view>
  </view>
  <view class="group-footer">选择“本人”以外的关系即为家属代为预约，提交时需确认已取得就诊人同意。</view>

  <view class="group" style="margin-top:40rpx;">
    <view class="field">
      <view class="field-label" style="flex:1;">设为默认就诊人</view>
      <switch checked="{{form.isDefault}}" color="#34C759" bindchange="onDefault" />
    </view>
  </view>

  <view wx:if="{{id}}" class="group" style="margin-top:40rpx;">
    <view class="cell" hover-class="cell-hover" bindtap="remove">
      <view class="cell-main cell-title danger" style="text-align:center;">移除就诊人</view>
    </view>
  </view>
</view>

<view class="bottom-bar">
  <view class="btn btn-primary btn-block {{saving ? 'btn-disabled' : ''}}" hover-class="pressed" bindtap="save">{{saving ? '正在保存…' : '保存'}}</view>
</view>
